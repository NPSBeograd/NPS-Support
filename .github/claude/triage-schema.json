{
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "type", "extension", "summary", "analysis", "standard_behavior", "references", "questions", "priority"],
  "properties": {
    "language": { "type": "string", "enum": ["sr", "en"] },
    "type": { "type": "string", "enum": ["bug", "suggestion", "question", "unclear"] },
    "extension": { "type": "string", "maxLength": 100 },
    "summary": { "type": "string", "maxLength": 2000 },
    "analysis": { "type": "string", "maxLength": 12000 },
    "standard_behavior": { "type": "string", "enum": ["yes", "no", "maybe", "unknown"] },
    "references": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "object", "note"],
        "properties": {
          "path": { "type": "string", "maxLength": 200 },
          "object": { "type": "string", "maxLength": 150 },
          "note": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "questions": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 500 } },
    "priority": { "type": "string", "enum": ["P1", "P2", "P3"] }
  }
}
